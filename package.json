{
  "name": "ai-creative-workstation",
  "productName": "AI Creative Workstation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "description": "AI Creative Workstation — local-first creative studio",
  "build": {
    "appId": "com.aicreativeworkstation.app",
    "productName": "AI Creative Workstation",
    "mac": {
      "category": "public.app-category.graphics-design",
      "extendInfo": {
        "CFBundleName": "AI Creative Workstation",
        "CFBundleDisplayName": "AI Creative Workstation",
        "NSMicrophoneUsageDescription": "AI Creative Workstation records your microphone for voice samples and voiceover.",
        "NSAudioCaptureUsageDescription": "AI Creative Workstation captures Mac playback (YouTube, games) as an audio track.",
        "NSScreenCaptureDescription": "Screen capture is used so macOS can attach system audio to the recording."
      }
    },
    "directories": {
      "output": "dist"
    }
  },
  "scripts": {
    "dev": "node scripts/brand-dev-electron.mjs && electron-vite dev",
    "postinstall": "node scripts/brand-dev-electron.mjs",
    "build": "npm run typecheck && electron-vite build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/sora": "^5.2.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
